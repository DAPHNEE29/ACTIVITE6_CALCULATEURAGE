<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalculateurAge.ViewModels"
             x:DataType="vm:CalculateurViewModel"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <!--
        Phase C : plus un seul x:Name, plus un seul Clicked. Tout passe par des
        {Binding} et des Command.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Nom" FontSize="16" />
            <Entry Placeholder="Votre nom"
                   Text="{Binding Nom, Mode=TwoWay}" />

            <Label Text="Date de naissance" FontSize="16" />
            <DatePicker Date="{Binding DateNaissance}" />

            <Button Text="Calculer"
                    Command="{Binding CalculerCommand}" />

            <Label Text="{Binding Resultat}"
                   FontSize="20"
                   IsVisible="{Binding ResultatVisible}" />

            <Button Text="Fiche détaillée"
                    Command="{Binding FicheCommand}"
                    IsVisible="{Binding ResultatVisible}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>